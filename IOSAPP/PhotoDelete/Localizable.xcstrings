          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePhoto nutzt keinen eigenen Cloud-Dienst und sendet Fotos nie an einen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePhoto does not use its own cloud service and never sends photos to a server."
          }
