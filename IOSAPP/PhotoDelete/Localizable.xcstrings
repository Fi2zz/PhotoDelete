    "照片很多时可能需要几秒，完成后会自动开始。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تستغرق المكتبات الكبيرة بضع ثوان. يبدأ التنظيف تلقائيا عندما تصبح جاهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei großen Mediatheken kann es einige Sekunden dauern. Das Aufräumen startet automatisch, sobald alles bereit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Large libraries can take a few seconds. Cleanup starts automatically when ready."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリが大きい場合は数秒かかることがあります。準備ができると自動で開始します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "照片很多时可能需要几秒，完成后会自动开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片很多時可能需要幾秒，完成後會自動開始。"
          }
        }
      }
    },
